{
  "name": "sorted",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node --experimental-strip-types --no-warnings scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:supabase": "(echo '// AUTO-GENERATED. Run pnpm types:supabase to refresh. Do not edit by hand.'; echo; supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public) > packages/schemas/src/supabase.generated.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@heroicons/react": "2.2.0",
    "@sentry/react": "^8",
    "@supabase/supabase-js": "^2.105.4",
    "@zootools/email-spell-checker": "1.12.0",
    "agora-chat": "^1.3.1",
    "agora-token": "2.0.5",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "jose": "^5.9.6",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260516.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^2",
    "@srtdio/briefs": "workspace:*",
    "@srtdio/comments": "workspace:*",
    "@srtdio/inbox": "workspace:*",
    "@srtdio/posts": "workspace:*",
    "@srtdio/rpc": "workspace:*",
    "@srtdio/schemas": "workspace:*",
    "@srtdio/storage": "workspace:*",
    "@srtdio/workspace": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "30.1.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "supabase": "2.98.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.4",
    "wrangler": "^3.114.17"
  }
}
