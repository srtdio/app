# Server-only secrets are configured in GitHub Actions Secrets and Cloudflare Pages env, never committed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase project ref. Required by `pnpm types:supabase` and the schema-drift
# CI gate to generate types from the live database.
SUPABASE_PROJECT_ID=your-project-ref
