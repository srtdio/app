# Server-only secrets are configured in GitHub Actions Secrets and Cloudflare Pages env, never committed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Asset-read Worker base URL (srtdio-asset-read). Mints short-lived presigned GET
# URLs for asset versions. Optional: when unset, the Assets library still lists
# and filters, but thumbnails and downloads are unavailable.
VITE_ASSET_READ_URL=https://srtdio-asset-read.example.workers.dev

# Asset-upload Worker base URL (srtdio-asset-upload). Accepts multipart
# {file, workspace_id} with a Bearer JWT and stores the asset. Optional: when
# unset, the Assets add menu opens the upload sheet but the commit stays disabled.
VITE_ASSET_UPLOAD_URL=https://srtdio-asset-upload.example.workers.dev

# Chat-token Worker URL (srtdio-chat-token). Mints short-lived Agora Chat user
# tokens for the signed-in workspace member. Optional: when unset, chat is
# unavailable and the rest of the app keeps working.
VITE_CHAT_TOKEN_URL=https://srtdio-chat-token.example.workers.dev

# Chat-transcribe Worker URL (srtdio-chat-transcribe). Accepts raw audio bytes
# with a Bearer JWT and returns { transcript }. Optional: when unset, voice
# notes still send without a transcript.
VITE_CHAT_TRANSCRIBE_URL=https://srtdio-chat-transcribe.example.workers.dev

# Supabase project ref. Required by `pnpm types:supabase` and the schema-drift
# CI gate to generate types from the live database.
SUPABASE_PROJECT_ID=your-project-ref
